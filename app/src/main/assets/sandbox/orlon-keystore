#!/bin/sh
# orlon-keystore ensure  -> creates a release signing key once; prints ORLON_KEYSTORE lines
. /usr/local/bin/orlon-env
mkdir -p "$ORLON_HOME"; KS="$ORLON_HOME/release.jks"; ENVF="$ORLON_HOME/keystore.env"
if [ ! -f "$KS" ] || [ ! -f "$ENVF" ]; then
  PW=$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n' | cut -c1-32)
  rm -f "$KS"
  keytool -genkeypair -keystore "$KS" -alias orlon -keyalg RSA -keysize 2048 -validity 10000 \
    -storepass "$PW" -keypass "$PW" -dname "CN=Orlon Code user, O=Orlon Code" >/dev/null 2>&1 || { echo "ORLON_ERROR could not create keystore" >&2; exit 1; }
  printf 'ORLON_KEYSTORE=%s\nORLON_KEYSTORE_PASSWORD=%s\nORLON_KEY_ALIAS=orlon\nORLON_KEY_PASSWORD=%s\n' "$KS" "$PW" "$PW" > "$ENVF"; chmod 600 "$ENVF" "$KS"
  echo "ORLON_KEYSTORE created $KS"
else
  echo "ORLON_KEYSTORE exists $KS"
fi
